---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import ProductStage from '../components/ProductStage.astro';
import { COLORWAYS, PRODUCT } from '../data/product';
import detail from '../assets/lamp/graphite-detail.webp';
import lit from '../assets/studio/04_lit.png';

const profiles = import.meta.glob<{ default: ImageMetadata }>('../assets/lamp/*-profile.webp', { eager: true });
const profileOf = (id: string) => profiles[`../assets/lamp/${id}-profile.webp`].default;

const anatomy = [
  ['01', 'Ressorts équilibreurs', 'Deux ressorts par segment compensent le poids du bras : aucune molette à serrer.'],
  ['02', 'Rotules en laiton', 'Axes traversants et boutons moletés, brossés à la main.'],
  ['03', 'Base lestée', 'Un disque de 22 cm qui garde la lampe stable, bras déplié.'],
  ['04', 'Abat-jour à réflecteur', 'Cône laqué à l’extérieur, mat à l’intérieur pour une lumière sans éblouissement.'],
];

const faq = [
  ['Puis-je vraiment acheter TENSIL ?', 'Non. TENSIL est une marque fictive créée pour un projet de portfolio. Le panier et la commande sont des simulations : rien n’est vendu ni facturé.'],
  ['Les photos sont-elles réelles ?', 'Ce sont des images de synthèse. La lampe a été modélisée, éclairée et rendue dans Blender ; la vue 3D utilise le même modèle.'],
  ['Que devient ce que je saisis à la commande ?', 'Rien ne quitte votre navigateur. Le panier est gardé dans le stockage local de votre navigateur, la commande fictive dans la session en cours.'],
  ['Pourquoi quatre coloris ?', 'Graphite, Sauge, Oxyde et Crème ont été définis dès la conception 3D. La vue 3D change la teinte de la laque en direct, sans recharger le modèle.'],
];

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'TENSIL — lampe de bureau articulée (produit fictif)',
  description: 'Produit de démonstration d’un projet de portfolio. Marque fictive, aucune vente réelle.',
  color: COLORWAYS.map((c) => c.name).join(', '),
};
---

<Base
  title="TENSIL"
  description="TENSIL, lampe de bureau articulée à ressorts : vue 3D à 360° en quatre coloris. Boutique de démonstration, marque fictive, aucune vente réelle."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productLd)} />

  <Intro />
  <ProductStage />

  <section class="manifesto section wrap" aria-labelledby="manifesto-title">
    <p class="eyebrow reveal"><b>01</b> Le principe</p>
    <h2 id="manifesto-title" class="h2 reveal">
      Une lampe qui ne lutte pas contre son poids&nbsp;: elle <em>l’équilibre</em>.
    </h2>
    <p class="lead reveal">
      Le mécanisme reprend un principe connu depuis les années 1930 : des ressorts tendus compensent le bras. TENSIL le
      réinterprète avec une silhouette propre, une base en disque et une tête conique.
    </p>
    <p class="dim manifesto__dim reveal">Portée du bras · 60 cm</p>
  </section>

  <section id="anatomie" class="anatomy" aria-labelledby="anatomy-title">
    <div class="anatomy__image reveal">
      <Image src={detail} alt="Gros plan sur une rotule en laiton et les ressorts de TENSIL" widths={[640, 1000, 1600]} sizes="(min-width: 64rem) 55vw, 100vw" />
    </div>
    <div class="anatomy__text wrap">
      <p class="eyebrow"><b>02</b> Anatomie</p>
      <h2 id="anatomy-title" class="h2">Ce qui la tient <em>en place.</em></h2>
      <ol class="anatomy__list">
        {
          anatomy.map(([n, title, text]) => (
            <li class="reveal">
              <span class="anatomy__num numeral">{n}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="night" aria-labelledby="night-title">
    <div class="night__grid wrap">
      <div class="night__copy">
        <p class="eyebrow"><b>03</b> À la nuit tombée</p>
        <h2 id="night-title" class="h2">Un cône de lumière, <em>posé sur le plan de travail.</em></h2>
        <p class="lead">
          L’abat-jour concentre la lumière sur le plan de travail. Le studio s’éteint, la lampe reste.
        </p>
        <button class="night__play link" type="button" data-play-film aria-controls="film">Voir le film (8 s)</button>
      </div>
      <figure class="night__media">
        <Image src={lit} alt="TENSIL allumée dans un studio sombre" widths={[640, 1000, 1600]} sizes="(min-width: 64rem) 60vw, 100vw" data-film-poster />
        <video
          id="film"
          class="night__video"
          src="/media/tensil_unfold.mp4"
          preload="none"
          muted
          playsinline
          controls
          hidden
          aria-label="Film de 8 secondes : la lampe se déplie puis s’allume. Sans son."
          data-film></video>
        <figcaption class="night__caption">Rendu Cycles · image de synthèse</figcaption>
      </figure>
    </div>
  </section>

  <section id="coloris" class="range section" aria-labelledby="range-title">
    <div class="wrap">
      <div class="range__head">
        <p class="eyebrow"><b>04</b> Coloris</p>
        <h2 id="range-title" class="h2">Quatre laques <em>au choix.</em></h2>
      </div>
      <ul class="range__list">
        {
          COLORWAYS.map((c, i) => (
            <li class="range__item reveal" style={`--delay:${i * 90}ms`}>
              <button type="button" class="range__btn" data-pick-colorway={c.id}>
                <Image src={profileOf(c.id)} alt="" widths={[400, 700]} sizes="(min-width: 64rem) 25vw, 50vw" />
                <span class="range__name">{c.name}</span>
                <span class="range__ref numeral">Réf. TNS-{c.id.slice(0, 3).toUpperCase()} · {c.hex.toUpperCase()}</span>
                <span class="range__cta">Voir en 3D<span class="visually-hidden"> le coloris {c.name}</span></span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="faq section wrap" aria-labelledby="faq-title">
    <h2 id="faq-title" class="h3">Questions</h2>
    <div class="faq__list">
      {
        faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <aside class="closing wrap" aria-label="Rappel">
    <p class="h3">TENSIL <span class="numeral">— {PRODUCT.price} €</span></p>
    <a class="btn" href="#lampe">Choisir un coloris <span aria-hidden="true">↑</span></a>
  </aside>
</Base>

<style>
  /* ---------------------------------------------------------------- manifesto */
  /* Asymmetric: title on the left two thirds, the explanation drops into the last column. */
  .manifesto {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem var(--gutter);
    align-items: end;
  }

  .manifesto .eyebrow {
    grid-column: 1 / -1;
  }

  .manifesto .h2 {
    grid-column: 1 / 3;
    max-width: 16ch;
  }

  .manifesto .lead {
    grid-column: 3;
  }

  .manifesto__dim {
    grid-column: 1 / -1;
    margin-top: 2rem;
  }

  /* ---------------------------------------------------------------- anatomy */
  .anatomy {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    border-block: 1px solid var(--line);
  }

  /* Portrait close-up (4:5) on a transparent background: the panel colour shows through. */
  .anatomy__image {
    position: relative;
    overflow: hidden;
    background: var(--paper-raised);
  }

  /* The close-up fills its cell instead of setting the row height: the section stays one screen tall. */
  .anatomy__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 60%;
  }

  .anatomy__text {
    display: grid;
    align-content: center;
    gap: 1.5rem;
    padding-block: 3rem;
    max-width: 38rem;
    margin: 0;
  }

  .anatomy__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .anatomy__list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.25rem 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }

  /* Callout balloon, as on an assembly drawing. */
  .anatomy__num {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--signal);
    border-radius: 50%;
    font-size: var(--t-micro);
    color: var(--signal);
  }

  .anatomy__list h3 {
    font-size: var(--t-body);
    font-weight: 600;
  }

  .anatomy__list p {
    font-size: var(--t-small);
    color: var(--ink-soft);
  }

  /* ---------------------------------------------------------------- night */
  .night {
    background: var(--night);
    color: var(--night-ink);
    padding-block: var(--section);
  }

  .night .eyebrow,
  .night .lead,
  .night__caption {
    color: var(--night-soft);
  }

  .night .eyebrow b {
    color: var(--signal-bright);
  }

  .night__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: var(--gutter);
    align-items: center;
  }

  .night__copy {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }

  .night__play {
    border: 0;
    background-color: transparent;
    color: var(--night-ink);
    cursor: pointer;
    padding-inline: 0;
  }

  .night__media {
    display: grid;
    gap: 1rem;
  }

  .night__media img,
  .night__video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .night__video[hidden],
  .night__media img[hidden] {
    display: none;
  }

  .night__caption {
    font-size: var(--t-micro);
    font-family: var(--mono);
    letter-spacing: 0;
  }

  /* ---------------------------------------------------------------- range */
  .range {
    background: var(--paper-sunk);
  }

  .range__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .range__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .range__item {
    background: var(--paper);
    transition-delay: var(--delay);
  }

  .range__btn {
    position: relative;
    display: grid;
    width: 100%;
    padding: 0 0 1.5rem;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .range__btn img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }

  .range__btn:hover img {
    transform: scale(1.04);
  }

  .range__name {
    padding-inline: 1.5rem;
    font-family: var(--display);
    font-stretch: var(--condensed);
    font-weight: 650;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .range__ref {
    padding-inline: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: var(--t-micro);
    color: var(--ink-soft);
  }

  .range__cta {
    padding-inline: 1.5rem;
    font-size: var(--t-micro);
    font-family: var(--mono);
    letter-spacing: 0;
    color: var(--ink-soft);
  }

  .range__btn:hover .range__cta {
    color: var(--signal);
  }

  /* ---------------------------------------------------------------- faq */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--gutter);
  }

  .faq__list {
    border-top: 1px solid var(--line);
  }

  .faq details {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--display);
    font-stretch: 85%;
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    font-family: var(--sans);
    font-weight: 300;
    transition: transform var(--fast) var(--ease);
  }

  .faq details[open] summary::after {
    transform: rotate(45deg);
  }

  .faq details p {
    padding-bottom: 1.5rem;
    max-width: 44rem;
    color: var(--ink-soft);
  }

  /* ---------------------------------------------------------------- closing */
  .closing {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  /* ---------------------------------------------------------------- responsive */
  @media (min-width: 64.01rem) {
    .anatomy__image {
      height: calc(100svh - var(--header-h) - 2px);
    }
  }

  @media (max-width: 64rem) {
    .anatomy,
    .night__grid,
    .faq,
    .manifesto {
      grid-template-columns: 1fr;
    }

    .manifesto .h2,
    .manifesto .lead {
      grid-column: 1;
    }

    .anatomy__image {
      aspect-ratio: 4 / 5;
      max-height: 80svh;
    }

    .range__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 52rem) {
    .closing {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
  }
</style>
