---
// Entry page content: the lamp turns in and lifts its head, then the visitor goes to the store.
// The film is rendered offline with Remotion from the same GLB (tools/remotion): the browser
// only plays an MP4 (180 KB, 94 KB on phones), no 3D runtime.
---

<section class="intro" aria-labelledby="intro-title">
  <video
    class="intro__film"
    poster="/media/intro-poster.jpg"
    width="1080"
    height="1080"
    muted
    playsinline
    preload="auto"
    disablepictureinpicture
    aria-hidden="true"
    data-intro-film>
    <!-- Phones show the film at ~250 CSS px: the 720 px render is enough and half the weight. -->
    <source src="/media/intro-720.mp4" type="video/mp4" media="(max-width: 40rem)" />
    <source src="/media/intro.mp4" type="video/mp4" />
  </video>
  <h1 id="intro-title" class="intro__mark">TENSIL</h1>
  <p class="intro__dim dim"><span>Lampe de bureau articulée</span></p>
  <a class="btn intro__enter" href="/lampe">
    <span>Découvrir la lampe</span>
    <span aria-hidden="true">→</span>
  </a>
</section>

<script>
  const film = document.querySelector<HTMLVideoElement>('[data-intro-film]');
  if (film) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Still frame: the final pose, no motion.
      film.addEventListener('loadedmetadata', () => (film.currentTime = film.duration), { once: true });
    } else {
      film.play().catch(() => {
        // Autoplay refused (power saving): the poster stays, the link still works.
      });
    }
  }
</script>

<style>
  .intro {
    min-height: calc(100svh - var(--banner-h));
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.25rem;
    padding: var(--gutter);
  }

  .intro__film {
    width: min(62vmin, 36rem);
    height: auto;
    aspect-ratio: 1;
    /* The film background is the page paper; the soft edge hides any drift from video encoding. */
    mask-image: radial-gradient(closest-side, #000 82%, transparent 100%);
  }

  .intro__mark {
    margin-top: -2rem;
    font-family: var(--logo);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.62em;
    margin-right: -0.62em;
    animation: intro-in 700ms var(--ease) 400ms both;
  }

  .intro__dim {
    width: min(62vmin, 36rem);
    animation: intro-in 700ms var(--ease) 600ms both;
  }

  .intro__dim span {
    color: var(--ink-soft);
  }

  /* The link arrives as the lamp settles into its pose. */
  .intro__enter {
    margin-top: 0.75rem;
    min-width: 16rem;
    animation: intro-in 700ms var(--ease) 2.2s both;
  }

  @keyframes intro-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
</style>
