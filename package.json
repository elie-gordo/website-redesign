{
  "name": "tensil-store",
  "version": "0.1.0",
  "private": true,
  "description": "Boutique de démonstration pour la lampe TENSIL (marque fictive, aucune vente réelle).",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run --dir tests/unit",
    "test:e2e": "playwright test",
    "screenshots": "node tools/screenshots.mjs",
    "fonts": "python tools/fonts/build_fonts.py"
  },
  "dependencies": {
    "astro": "7.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/azeret-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
